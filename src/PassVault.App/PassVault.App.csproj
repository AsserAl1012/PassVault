<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PassVault.Core\PassVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\brand\passvault.ico" Link="passvault.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\brand\passvault.ico</ApplicationIcon>
    <AssemblyName>PassVault</AssemblyName>
    <Product>PassVault</Product>
    <Company>PassVault</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>A password manager that needs your USB stick, your PC and your PIN.</Description>
  </PropertyGroup>

</Project>
