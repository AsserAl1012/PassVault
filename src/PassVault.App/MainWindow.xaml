<Window x:Class="PassVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassVault.App"
        Title="PassVault" Height="710" Width="1000" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Void}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded" Closed="OnClosed"
        PreviewMouseMove="OnUserActive" PreviewKeyDown="OnUserActive">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Quiet}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= top bar ================= -->
        <Grid Grid.Row="0" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="420" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="34,8,10,8"/>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"
                           Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Search your credentials" Foreground="{StaticResource Muted}"
                           Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Button Grid.Column="1" Content="Add credential"
                    Margin="12,0,8,0" Click="OnAdd"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Back up" Margin="0,0,8,0" Click="OnBackup"/>
                <Button Content="Lock" Click="OnLock"/>
            </StackPanel>
        </Grid>

        <!-- ================= list + details ================= -->
        <Grid Grid.Row="1" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                             Padding="6" SelectionChanged="OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Row" CornerRadius="3" Padding="13,9,11,9">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="Transparent"/>
                                                    </Border.Background>
                                                    <ContentPresenter/>
                                                </Border>
                                                <!-- Selection is grey plus a brass bar, not a blue wash. The bar is
                                                     always there and fades in, so nothing has to move or resize. -->
                                                <Border x:Name="Bar" Width="2" HorizontalAlignment="Left"
                                                        Margin="0,4" CornerRadius="1" Opacity="0"
                                                        Background="{StaticResource Accent}" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Row"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                To="{StaticResource RaisedColor}"
                                                                                Duration="{StaticResource Shift}"
                                                                                EasingFunction="{StaticResource EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Row"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                To="Transparent"
                                                                                Duration="{StaticResource Shift}"
                                                                                EasingFunction="{StaticResource EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Row"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                To="{StaticResource ActiveColor}"
                                                                                Duration="{StaticResource Shift}"
                                                                                EasingFunction="{StaticResource EaseOut}"/>
                                                                <DoubleAnimation Storyboard.TargetName="Bar"
                                                                                 Storyboard.TargetProperty="Opacity" To="1"
                                                                                 Duration="{StaticResource Shift}"
                                                                                 EasingFunction="{StaticResource EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Row"
                                                                                Storyboard.TargetProperty="Background.Color"
                                                                                To="Transparent"
                                                                                Duration="{StaticResource Shift}"
                                                                                EasingFunction="{StaticResource EaseOut}"/>
                                                                <DoubleAnimation Storyboard.TargetName="Bar"
                                                                                 Storyboard.TargetProperty="Opacity" To="0"
                                                                                 Duration="{StaticResource Shift}"
                                                                                 EasingFunction="{StaticResource EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Who}" Foreground="{StaticResource Muted}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyListText" Text="Nothing saved yet" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- details -->
            <Border Grid.Column="1" CornerRadius="4" Margin="14,0,0,0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="NothingChosen" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Pick something on the left, or add a credential"/>

                    <Grid x:Name="Details" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel Margin="24,22,24,10">

                            <TextBlock Text="Website or app" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox" TextChanged="OnFieldEdited"/>

                            <TextBlock Text="Username" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="UsernameBox" TextChanged="OnFieldEdited" Padding="10,8,42,8"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="Copy"
                                        HorizontalAlignment="Right" Margin="0,0,3,0" Click="OnCopyUsername">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Email" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="EmailBox" TextChanged="OnFieldEdited" Padding="10,8,42,8"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="Copy"
                                        HorizontalAlignment="Right" Margin="0,0,3,0" Click="OnCopyEmail">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="PasswordBoxText" TextChanged="OnFieldEdited"
                                         FontFamily="Consolas" Padding="10,8,80,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                                    <Button x:Name="ShowHideButton" Style="{StaticResource IconButton}"
                                            ToolTip="Show or hide" Click="OnToggleShowPassword">
                                        <TextBlock x:Name="ShowHideGlyph" Style="{StaticResource Glyph}" Text="&#xE7B3;"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Copy" Click="OnCopyPassword">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <TextBox x:Name="NotesBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" TextChanged="OnFieldEdited"/>
                        </StackPanel>
                      </ScrollViewer>

                      <Border Grid.Row="1" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                              Padding="24,14">
                          <!-- The confirmation happens here, in place. It used to be a
                               MessageBox: a light-grey Win32 dialog in the middle of a dark
                               product, which is the single cheapest thing to get rid of. -->
                          <Grid>
                              <StackPanel x:Name="FooterNormal" Orientation="Horizontal">
                                  <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save"
                                          IsEnabled="False" Click="OnSave"/>
                                  <Button Content="Delete" Margin="8,0,0,0"
                                          Foreground="{StaticResource Danger}" Click="OnDeleteAsked"/>
                              </StackPanel>

                              <StackPanel x:Name="FooterConfirm" Orientation="Horizontal"
                                          Visibility="Collapsed" Opacity="0">
                                  <TextBlock x:Name="ConfirmText" VerticalAlignment="Center"
                                             Margin="0,0,16,0"/>
                                  <Button Style="{StaticResource Destructive}" Content="Delete for good"
                                          Click="OnDeleteConfirmed"/>
                                  <Button Style="{StaticResource Quiet}" Content="Cancel"
                                          Margin="8,0,0,0" Click="OnDeleteCancelled"/>
                              </StackPanel>
                          </Grid>
                      </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= the state band =================
             Was a 12px grey line at the very bottom edge. The auto-lock now has a visible
             countdown, because locking after five minutes with no warning at all is a
             defect, not a design choice. -->
        <local:StateBand x:Name="Band" Grid.Row="2" Height="46" Margin="18,14,18,16"
                         Glyph="&#xE785;" State="Vault open" Mood="Good"/>
    </Grid>
</Window>
