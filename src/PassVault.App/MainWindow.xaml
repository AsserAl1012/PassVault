<Window x:Class="PassVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassVault" Height="710" Width="1000" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#16181D" FontFamily="Segoe UI" FontSize="14"
        Loaded="OnLoaded" Closed="OnClosed"
        PreviewMouseMove="OnUserActive" PreviewKeyDown="OnUserActive">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Quiet}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= top bar ================= -->
        <Grid Grid.Row="0" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="420" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="34,8,10,8"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Search your credentials" Foreground="{StaticResource Muted}"
                           Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Add credential"
                    Margin="12,0,8,0" Click="OnAdd"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Back up" Margin="0,0,8,0" Click="OnBackup"/>
                <Button Content="Lock" Click="OnLock"/>
            </StackPanel>
        </Grid>

        <!-- ================= list + details ================= -->
        <Grid Grid.Row="1" Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                             Padding="6" SelectionChanged="OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="7" Padding="11,9" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#252931"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#2C3C5C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Who}" Foreground="{StaticResource Muted}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyListText" Text="Nothing saved yet" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- details -->
            <Border Grid.Column="1" CornerRadius="10" Margin="14,0,0,0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="NothingChosen" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Pick something on the left, or add a credential"/>

                    <Grid x:Name="Details" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel Margin="24,22,24,10">

                            <TextBlock Text="Website or app" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NameBox" TextChanged="OnFieldEdited"/>

                            <TextBlock Text="Username" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="UsernameBox" TextChanged="OnFieldEdited" Padding="10,8,42,8"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy"
                                        HorizontalAlignment="Right" Margin="0,0,3,0" Click="OnCopyUsername"/>
                            </Grid>

                            <TextBlock Text="Email" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="EmailBox" TextChanged="OnFieldEdited" Padding="10,8,42,8"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy"
                                        HorizontalAlignment="Right" Margin="0,0,3,0" Click="OnCopyEmail"/>
                            </Grid>

                            <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <Grid>
                                <TextBox x:Name="PasswordBoxText" TextChanged="OnFieldEdited"
                                         FontFamily="Consolas" Padding="10,8,80,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                                    <Button x:Name="ShowHideButton" Style="{StaticResource IconButton}"
                                            Content="&#xE7B3;" ToolTip="Show or hide" Click="OnToggleShowPassword"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy"
                                            Click="OnCopyPassword"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,13,0,5"/>
                            <TextBox x:Name="NotesBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" TextChanged="OnFieldEdited"/>
                        </StackPanel>
                      </ScrollViewer>

                      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                              Padding="24,14">
                          <StackPanel Orientation="Horizontal">
                              <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save"
                                      IsEnabled="False" Click="OnSave"/>
                              <Button Content="Delete" Margin="8,0,0,0" Foreground="#FF8A8A" Click="OnDelete"/>
                          </StackPanel>
                      </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= status line ================= -->
        <Grid Grid.Row="2" Margin="20,12,20,12">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"/>
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Good}" FontSize="12"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
