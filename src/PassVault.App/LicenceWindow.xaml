<Window x:Class="PassVault.App.LicenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassVault.App"
        Title="PassVault" Height="730" Width="520"
        Icon="passvault.ico" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Void}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded">

    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:StateBand x:Name="Band" Grid.Row="0" Height="60" Margin="0,0,0,22"
                         Glyph="&#xE8D7;"/>

        <Grid Grid.Row="1">

            <!-- ============ already owned ============ -->
            <StackPanel x:Name="OwnedPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                           Text="Thank you. This copy is yours: it never expires, it has no account, and it never contacts anything. Nobody can switch it off, including me."/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Licence" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="OwnerId" Style="{StaticResource Mono}"/>
                        <TextBlock x:Name="OwnerIssued" Style="{StaticResource Sub}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource Quiet}" Content="Remove this licence from this PC"
                        HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnRemove"/>
            </StackPanel>

            <!-- ============ free version ============ -->
            <StackPanel x:Name="FreePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap"
                           Text="You are using the free version. It is complete and it is safe - nothing about your security is behind a payment, and it never will be."/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Free, always" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap"
                                   Text="As many credentials as you like &#183; the full strength of the encryption &#183; your 12-word recovery phrase &#183; backups &#183; re-keying after a theft &#183; getting your data back out"/>

                        <TextBlock Text="What buying adds" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <TextBlock Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap"
                                   Text="Importing from other password managers &#183; more than one vault &#183; the browser extension and sync, when they exist &#183; your name in the app"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="2,16,0,0" TextWrapping="Wrap"
                           Text="One payment. Not a subscription. It never expires, works offline forever, and if this project is ever abandoned the source code gets published so it cannot die on you."/>

                <TextBlock Text="Already have a licence? Paste it here" Style="{StaticResource Label}" Margin="0,20,0,6"/>
                <TextBox x:Name="PasteBox" Height="92" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="11"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                <Button Style="{StaticResource Primary}" Content="Use this licence"
                        Margin="0,14,0,0" Click="OnApply"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="Message" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{StaticResource Danger}"/>
            <Button Content="Close" HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
