<UserControl x:Class="PassVault.App.SiteMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Tile" CornerRadius="3"
            Background="{StaticResource Raised}" BorderBrush="{StaticResource Hairline}"
            BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <!-- Every Simple Icons path is drawn in a 24x24 box, so one Viewbox fits them all. -->
            <Viewbox x:Name="Art" Width="15" Height="15" Visibility="Collapsed">
                <Path x:Name="Brand"/>
            </Viewbox>

            <!-- Anything we do not have artwork for still gets a mark of its own. -->
            <TextBlock x:Name="Letter" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextOptions.TextFormattingMode="Ideal"/>
        </Grid>
    </Border>
</UserControl>
