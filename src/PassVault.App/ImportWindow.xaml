<Window x:Class="PassVault.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassVault.App"
        Title="PassVault - import" SizeToContent="Height" Width="520"
        Icon="passvault.ico" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Void}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded">

    <!-- Nothing is added until Import is pressed. A whole file of credentials going in at
         once deserves one look first - and a look at the names, never the passwords. -->
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:StateBand x:Name="Band" Grid.Row="0" Height="60" Margin="0,0,0,22"
                         Glyph="&#xE8B5;"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,26">
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="What comes in" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="Preview" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Ticked by default. The export holds every password in plain text, and the
                 usual place for it is Downloads, where it would otherwise sit for years. -->
            <CheckBox x:Name="DeleteAfter" IsChecked="True" Margin="2,22,0,0"
                      Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="DeleteHint" Style="{StaticResource Sub}" FontSize="12" Margin="24,6,0,0" TextWrapping="Wrap"
                       Text="It holds every one of these passwords in plain text. Anyone who gets that file gets them all."/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Quiet}" Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ImportButton" Style="{StaticResource Primary}" IsDefault="True" Click="OnImport"/>
        </StackPanel>
    </Grid>
</Window>
