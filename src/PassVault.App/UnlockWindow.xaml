<Window x:Class="PassVault.App.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassVault.App"
        Title="PassVault" Height="600" Width="480"
        Icon="passvault.ico" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Void}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded" Closed="OnClosed">

    <Grid Margin="36,30,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The name, small. The band below it is the thing that matters. -->
        <TextBlock Grid.Row="0" Text="PASSVAULT" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                   Margin="0,2,0,20"/>

        <!-- The state band: the largest thing on this screen, because which state you are in
             is the only fact that decides whether the app can do anything at all. -->
        <local:StateBand x:Name="Band" Grid.Row="1" Height="64" Margin="0,0,0,24"
                         State="Looking for your stick..." Mood="Idle"/>

        <!-- ============ the body swaps between these ============ -->
        <Grid Grid.Row="2">

            <!-- no stick plugged in -->
            <StackPanel x:Name="NoStickPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Sub}" TextAlignment="Center"
                           Text="PassVault cannot open without your stick. Plug it in and this screen will notice on its own."/>
                <TextBlock x:Name="DrivesFound" Style="{StaticResource Sub}" TextAlignment="Center"
                           FontSize="12" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- stick is empty: offer to set it up -->
            <StackPanel x:Name="NewStickPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Sub}" TextAlignment="Center"
                           Text="There is no vault on this stick yet. Setting it up creates your vault and gives you a 12-word recovery phrase."/>
                <Button x:Name="SetUpStickButton" Style="{StaticResource Primary}" Content="Set up this stick"
                        Margin="0,22,0,0" Click="OnSetUpStick"/>
            </StackPanel>

            <!-- the 12 words, shown once -->
            <StackPanel x:Name="WordsPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Write these 12 words down, on paper" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14"
                           Text="They are shown once and stored nowhere. They are the only way back in if this stick is lost or broken."/>
                <Border CornerRadius="4" Padding="14" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <ItemsControl x:Name="WordsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,5">
                                    <TextBlock Text="{Binding Number}" Foreground="{StaticResource Muted}"
                                               FontSize="11" Width="20" TextAlignment="Right" Margin="0,2,7,0"/>
                                    <TextBlock Text="{Binding Word}" FontFamily="Consolas" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <CheckBox x:Name="WrittenDown" Foreground="{StaticResource Muted}" Margin="2,16,0,0"
                          Content="I have written them down" Checked="OnWrittenDownChanged" Unchecked="OnWrittenDownChanged"/>
                <Button x:Name="WordsNextButton" Style="{StaticResource Primary}" Content="Continue"
                        Margin="0,16,0,0" IsEnabled="False" Click="OnWordsDone"/>
            </StackPanel>

            <!-- set this PC up: type the 12 words -->
            <StackPanel x:Name="EnrolPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Set this PC up" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14"
                           Text="Type your 12 words once. After this, your stick and a PIN are all you need on this PC."/>
                <TextBox x:Name="PhraseBox" Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" VerticalContentAlignment="Top"/>
                <Button Style="{StaticResource Primary}" Content="Continue" Margin="0,16,0,0" Click="OnEnrolPhrase"/>
            </StackPanel>

            <!-- choose a PIN -->
            <StackPanel x:Name="PinSetupPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Choose a 4-digit PIN" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,16"
                           Text="This is what you will type every day, with your stick plugged in."/>
                <TextBlock Text="PIN" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="NewPinBox" MaxLength="4" FontSize="20" PasswordChar="*"
                             HorizontalContentAlignment="Center"/>
                <TextBlock Text="Type it again" Style="{StaticResource Label}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="NewPinAgainBox" MaxLength="4" FontSize="20" PasswordChar="*"
                             HorizontalContentAlignment="Center" KeyDown="OnPinSetupKey"/>
                <Button Style="{StaticResource Primary}" Content="Finish setting up"
                        Margin="0,18,0,0" Click="OnPinChosen"/>
            </StackPanel>

            <!-- the everyday unlock -->
            <StackPanel x:Name="PinPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Enter your PIN" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <PasswordBox x:Name="PinBox" MaxLength="4" FontSize="26" PasswordChar="*"
                             HorizontalContentAlignment="Center" Padding="10,12"
                             PasswordChanged="OnPinTyped" KeyDown="OnPinKey"/>
                <Button Style="{StaticResource Quiet}" Content="Use my 12 words instead"
                        Margin="0,16,0,0" Click="OnUsePhraseInstead"/>
            </StackPanel>

            <!-- recovery: type the 12 words to get in -->
            <StackPanel x:Name="PhrasePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Your 12 words" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="0,0,0,14"
                           Text="This works even if the PIN has been switched off, and it switches it back on."/>
                <TextBox x:Name="RecoveryBox" Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" VerticalContentAlignment="Top"/>
                <Button Style="{StaticResource Primary}" Content="Open my vault" Margin="0,16,0,0" Click="OnPhraseUnlock"/>
                <Button Style="{StaticResource Quiet}" Content="Back to PIN" Margin="0,8,0,0" Click="OnBackToPin"/>
            </StackPanel>

            <!-- The unlock second. Top-aligned like every other panel - the old one was
                 centred, so the content visibly leapt down the window as the wait began. -->
            <StackPanel x:Name="BusyPanel" Visibility="Collapsed" VerticalAlignment="Top"
                        Margin="0,28,0,0">
                <local:LockMechanism x:Name="Mechanism"/>
            </StackPanel>
        </Grid>

        <!-- messages -->
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="Message" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" Foreground="{StaticResource Danger}" MinHeight="34"/>
            <Button Style="{StaticResource Quiet}" Content="Stick lost, stolen or broken?"
                    FontSize="12" HorizontalAlignment="Center" Click="OnRecovery"/>
        </StackPanel>
    </Grid>
</Window>
