<Window x:Class="PassVault.App.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassVault - replace your stick" Height="680" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#16181D" FontFamily="Segoe UI" FontSize="14"
        Loaded="OnLoaded" Closed="OnClosed">

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="StepTitle" Text="Replace your stick" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="StepSub" Style="{StaticResource Sub}" FontSize="13" Margin="0,7,0,0"
                       Text="Use this if your stick was stolen, lost or broken."/>
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- 1. where the vault is coming from -->
            <StackPanel x:Name="SourcePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <Border CornerRadius="9" Padding="15,13" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Your credentials will come from" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="SourceText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SourceDetail" Style="{StaticResource Sub}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="2,18,0,0" TextWrapping="Wrap"
                           Text="What happens next: a brand new master key, a brand new 12-word phrase and a brand new stick. The old stick stops working the moment this finishes, even if someone has it."/>

                <Button x:Name="SourceNext" Style="{StaticResource Primary}" Content="Continue"
                        Margin="0,22,0,0" Click="OnSourceNext"/>
                <Button Style="{StaticResource Quiet}" Content="Use a backup file instead"
                        Margin="0,8,0,0" Click="OnPickBackupFile"/>
            </StackPanel>

            <!-- 2. the old 12 words -->
            <StackPanel x:Name="PhrasePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Your current 12 words" Style="{StaticResource Label}"/>
                <TextBox x:Name="PhraseBox" Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" VerticalContentAlignment="Top"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
                           Text="These are the words you have now. You will be given new ones at the end."/>
                <Button Style="{StaticResource Primary}" Content="Continue" Margin="0,22,0,0" Click="OnPhraseNext"/>
            </StackPanel>

            <!-- 3. which drive to write -->
            <StackPanel x:Name="StickPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Plug in the new stick and pick it below" Style="{StaticResource Label}"/>
                <Border CornerRadius="9" Height="180" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" Padding="6"
                                 SelectionChanged="OnDriveChosen">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,7">
                                        <TextBlock Text="{Binding Root}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoDrives" Text="No stick found yet - plug one in"
                                   Foreground="{StaticResource Muted}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
                           Text="Anything already on the stick is left alone - PassVault only uses its own folder. A stick holding a different PassVault will be refused."/>
                <Button x:Name="StickNext" Style="{StaticResource Primary}" Content="Continue"
                        Margin="0,20,0,0" IsEnabled="False" Click="OnStickNext"/>
            </StackPanel>

            <!-- 4. a PIN for this PC -->
            <StackPanel x:Name="PinPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="PIN for this PC" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="NewPinBox" MaxLength="4" FontSize="20" PasswordChar="*"
                             HorizontalContentAlignment="Center"/>
                <TextBlock Text="Type it again" Style="{StaticResource Label}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="NewPinAgainBox" MaxLength="4" FontSize="20" PasswordChar="*"
                             HorizontalContentAlignment="Center" KeyDown="OnPinKey"/>
                <TextBlock Style="{StaticResource Sub}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
                           Text="The new keys mean this PC has to be set up again. Any other PC you use will need its 12 words once too."/>
                <Button Style="{StaticResource Primary}" Content="Make the new stick"
                        Margin="0,20,0,0" Click="OnGo"/>
            </StackPanel>

            <!-- 5. done -->
            <Grid x:Name="DonePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="9" Padding="14" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Your NEW 12 words - write them down now" Style="{StaticResource Label}"/>
                        <ItemsControl x:Name="WordsList" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,5">
                                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource Muted}"
                                                   FontSize="11" Width="20" TextAlignment="Right" Margin="0,2,7,0"/>
                                        <TextBlock Text="{Binding Word}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Style="{StaticResource Sub}" FontSize="12" Margin="2,16,0,8" TextWrapping="Wrap"
                           Text="Whoever had the old stick may have copied the encrypted vault off it. They cannot open it, but the safe move is to change these passwords. Tick them off as you go."/>

                <Border Grid.Row="2" CornerRadius="9" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <ItemsControl x:Name="ChangeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" Foreground="{StaticResource Text}" Margin="2,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel x:Name="BusyPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="BusyText" Text="Working..." Style="{StaticResource Sub}" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource Bad}" MinHeight="32" VerticalAlignment="Center"/>
            <Button x:Name="FinishButton" Style="{StaticResource Primary}" Content="Open my vault"
                    HorizontalAlignment="Right" Visibility="Collapsed" Click="OnFinish"/>
        </Grid>
    </Grid>
</Window>
